# Сборка gRPC API (multi-stage, без CGO).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/api ./cmd/api

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /bin/api /bin/api
VOLUME ["/data"]
ENV DB_PATH=/data/mini-owl.db GRPC_ADDR=:50051
EXPOSE 50051
ENTRYPOINT ["/bin/api"]
