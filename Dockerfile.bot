# Сборка Telegram-бота (multi-stage, без CGO).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /bin/bot ./cmd/bot

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /bin/bot /bin/bot
ENV GRPC_ADDR=api:50051
ENTRYPOINT ["/bin/bot"]
